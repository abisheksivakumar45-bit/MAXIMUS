# =============================================================================
# MAXIMUS — environment configuration (EXAMPLE)
#
# Copy this file to `.env` and adjust values:
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# The real `.env` file is git-ignored. NEVER commit real credentials.
# These defaults are for local development only.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- PostgreSQL --------------------------------------------------------------
# Used by Docker Compose to initialise the database and by the backend when it
# runs inside Docker (host `db`).
POSTGRES_USER=maximus_dev
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=maximus_dev
POSTGRES_PORT=5432

# --- Backend -----------------------------------------------------------------
BACKEND_PORT=8000

# Host-side DATABASE_URL for running the backend directly on your machine
# (outside Docker). URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://maximus_dev:change_me_local_only@localhost:5432/maximus_dev

# Comma-separated list of allowed browser origins (strict CORS).
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required from Phase 2 onward. Used to protect session tokens; the backend
# refuses to start without a value of at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Server-managed session settings (Phase 2).
# How long a login session stays valid.
SESSION_LIFETIME_DAYS=30
# Set to true when serving over HTTPS so session cookies get the Secure flag.
COOKIE_SECURE=false
# Sliding-window rate limit applied to the login and registration endpoints.
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Frontend ----------------------------------------------------------------
FRONTEND_PORT=5173
# Leave empty so the browser calls the Vite dev server (which proxies /api to
# the backend). Set to an absolute URL only if the API is hosted elsewhere.
VITE_API_BASE_URL=

# --- AI roadmap generation (Phase 4) -----------------------------------------
# Leave AI_PROVIDER=none (the default) to run the whole application without any
# outbound AI call. Roadmap generation then reports "not configured" honestly;
# it never fabricates a roadmap.
#
# Supported provider: `openai` — any OpenAI-compatible Chat Completions endpoint
# (OpenAI, OpenRouter, Groq, a local Ollama/LM Studio server, ...). The API key
# is backend-only: it is never sent to the browser, logged, or returned by the
# API. Supply real values in your local `.env` only; never commit them.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
# Explicit network bounds and bounded retries (0-5).
AI_CONNECT_TIMEOUT_SECONDS=10
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=4000
AI_TEMPERATURE=0.3
# Ask OpenAI-compatible endpoints for a JSON object response.
AI_JSON_MODE=true

# Expensive generation is limited per authenticated user, not per IP.
ROADMAP_RATE_LIMIT_ATTEMPTS=5
ROADMAP_RATE_LIMIT_WINDOW_SECONDS=300
